      "featured": true,
      "name": "허블 소리굽쇠",
      "nameI18n": {
        "en": "Hubble Tuning Fork"
      },
      "summary": "은하를 형태로 분류하는 지도 — 타원에서 나선·막대나선으로 갈라진다. 진화 순서 아님.",
      "summaryI18n": {
        "en": "A map that classifies galaxies by shape — ellipticals branch into spirals and barred spirals. Not an evolutionary sequence."
      },
      "scene": "scene-hubble-fork",
      "hostCard": false,
      "facts": [
        {
          "label": "손잡이",
          "value": "타원 E0~E7 → 렌즈 S0"
        },
        {
          "label": "갈래",
          "value": "나선 S / 막대나선 SB"
        }
      ],
      "factsI18n": {
        "en": [
          {
            "label": "Handle",
            "value": "Elliptical E0–E7 → lenticular S0"
          },
          {
            "label": "Prongs",
            "value": "Spiral S / barred spiral SB"
          }
        ]
      },
      "related": [
        "agn",
        "andromeda",
        "milky-way"
      ],
      "crossAxis": [
        "light-delay"
      ]
    },
